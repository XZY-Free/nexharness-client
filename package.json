{
  "name": "nexharness-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NexHarness 客户端（Web SPA + Desktop + 客户端 SDK）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build:desktop-renderer": "node scripts/build-desktop-renderer.mjs",
    "build:desktop": "pnpm build:desktop-renderer && tsc -p desktop/tsconfig.json && node scripts/build-desktop.mjs",
    "rebuild:desktop-native": "node scripts/rebuild-desktop-native.mjs",
    "dev:desktop": "pnpm build:desktop && pnpm rebuild:desktop-native && electron desktop/package-app",
    "package:desktop": "pnpm build:desktop && pnpm rebuild:desktop-native && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config desktop/electron-builder.yml --mac --arm64",
    "package:desktop:signed": "pnpm build:desktop && pnpm rebuild:desktop-native && electron-builder --config desktop/electron-builder.yml --mac --arm64"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.50",
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-virtual": "^3.14.3",
    "ai": "6.0.116",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "execa": "^9.6.1",
    "lucide-react": "^1.26.0",
    "next-themes": "^0.4.6",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@electron/rebuild": "4.2.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "0.25.12",
    "playwright": "^1.61.1",
    "postcss": "^8.5.26",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "7.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "better-sqlite3", "esbuild"]
  }
}
